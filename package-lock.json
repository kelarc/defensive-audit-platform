{
  "name": "defensive-audit-platform",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "defensive-audit-platform",
      "version": "1.0.0",
      "license": "ISC",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/api": {
      "name": "@audit/api",
      "version": "0.1.0",
      "dependencies": {
        "@audit/shared": "*"
      }
    },
    "node_modules/@audit/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@audit/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/shared": {
      "name": "@audit/shared",
      "version": "0.1.0"
    }
  }
}
